{
  "name": "command-app-secure-staging",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "ACCESS_ISSUER": "https://frosty-frog-d5d8.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "command-secure-staging",
    "database_id": "REPLACE_WITH_NEW_STAGING_D1_ID"
  }]
}
