# Base44 sandbox runtime for CROS.
#
# Plain Node runtime only: no application source is copied in, and no build is
# run. The repository is bind-mounted at /app by docker-compose.base44.yml so
# the live-reload dev server always serves the cloned (editable) source.
FROM node:22-bookworm-slim

# Match package.json "packageManager" so the pinned pnpm is available offline.
RUN corepack enable && corepack prepare pnpm@10.18.0 --activate

WORKDIR /app
